  "mechanisms": [
    {
      "mechanism_id": "M11",
      "title": "销售代替当事人确认订立合同文书",
      "overview": "第29条针对订立保险合同有关文书确认，保险销售人员不得代确认；不得额外要求已伪造本人记录才认定该代确认筛查线索。合同订立后的回访身份答问应走M01/M02，不能只因“确认”二字触发M11。 解释页面、放大字体等辅助与替客户作确认分开；非销售人员书面受托须核法律认可方式，不能拿笼统授权绕过销售人员禁止。万能险风险告知代操作另核L005第17条，即使透明也不能当成允许。M11不当然支持“客户信息不真实”标签，需独立虚假记录事实。",
      "coverage": {
        "status": "partial",
        "support_documents": 10,
        "planned_support_documents": 16,
        "support_event_groups": 8,
        "all_mechanism_cases_exhaustive": false,
